# Docker Compose Postgres (required for backend bootRun)
POSTGRES_PASSWORD=change-me-local-only

# Spring datasource (defaults in application.yaml match these)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tickets
SPRING_DATASOURCE_USERNAME=tickets
SPRING_DATASOURCE_PASSWORD=change-me-local-only

# Frontend
VITE_API_BASE_URL=http://localhost:8080
